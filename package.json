{
  "name": "quilt-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production tsc -b && NODE_ENV=production vite build",
    "deploy": "npm run build && gh-pages -d dist -r git@github.com:eahenke/quilt-react.git",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "jest",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@mantine/core": "^7.9.2",
    "@mantine/hooks": "^7.9.2",
    "classnames": "^2.5.1",
    "csv-generate": "^4.4.0",
    "csv-parse": "^5.5.5",
    "csv-stringify": "^6.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript-eslint": "^8.57.0"
  },
  "devDependencies": {
    "@types/csv-parse": "^1.2.2",
    "@types/csv-stringify": "^3.1.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.38",
    "postcss-preset-mantine": "^1.15.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.2.2",
    "vite": "^7.3.1"
  }
}
